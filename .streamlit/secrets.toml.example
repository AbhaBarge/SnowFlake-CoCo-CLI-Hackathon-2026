# .streamlit/secrets.toml
# This file is .gitignored - NEVER commit it.
#
# LOCAL TESTING: Copy this to .streamlit/secrets.toml and fill in real values.
# STREAMLIT CLOUD: Paste the [connections.snowflake] block into
#                  Settings > Secrets in the Streamlit Cloud dashboard.

[connections.snowflake]
account = "qi07886.ap-southeast-7.aws"
user = "ABHABARGE"
password = "REPLACE_WITH_YOUR_PASSWORD"
role = "ACCOUNTADMIN"
warehouse = "COMPUTE_WH"
database = "AML_COPILOT_DB"
schema = "RISK_ENGINE"
client_session_keep_alive = true
