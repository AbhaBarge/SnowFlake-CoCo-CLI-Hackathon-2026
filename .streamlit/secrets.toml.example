# .streamlit/secrets.toml
# This file is .gitignored — NEVER commit it.
# Copy this to .streamlit/secrets.toml and fill in your values for local testing.
# For Streamlit Community Cloud, add these in the app's Secrets UI instead.

[connections.snowflake]
account = "qi07886.ap-southeast-7.aws"
user = "ABHABARGE"
password = "YOUR_PASSWORD_HERE"
warehouse = "COMPUTE_WH"
database = "AML_COPILOT_DB"
schema = "RISK_ENGINE"
role = "ACCOUNTADMIN"
